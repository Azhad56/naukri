# Copy this file to .env and fill in your values.
# NEVER commit .env
# Login session is stored separately in data/chrome-profile/ (gitignored).
# Naukri password is never stored anywhere — you log in manually once via
# `npm run login`.

CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_LOCATION=
TOTAL_YEARS_EXPERIENCE=5
CURRENT_CTC_LPA=
EXPECTED_CTC_LPA=
NOTICE_PERIOD_DAYS=0
NOTICE_PERIOD_TEXT=Immediate
WILLING_TO_RELOCATE=true
WILLING_TO_TRAVEL=true
REQUIRES_SPONSORSHIP=false

# Optional: relative path (from this folder) to a resume PDF, only used to
# ground the local AI fallback for unrecognized screening questions. Naukri
# itself always uses the resume already attached to your profile.
RESUME_PATH=

SEARCH_KEYWORDS=Node.js Developer,Backend Developer,Full Stack Developer
SEARCH_EXPERIENCE_YEARS=5
SEARCH_LOCATION=
SEARCH_FRESHNESS=Last 3 days
SEARCH_SORT_BY=Date

MAX_APPLICATIONS_PER_RUN=15
MAX_APPLICATIONS_PER_KEYWORD=8
MAX_PAGES_PER_KEYWORD=5

AI_ENABLED=true
AI_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434/api/generate
