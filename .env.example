# Copy this file to .env and fill in your values.
# NEVER commit .env
# Login session is stored separately in data/chrome-profile/ (gitignored).
# Naukri password is never stored anywhere — you log in manually once via
# `npm run login`.

CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_LOCATION=
TOTAL_YEARS_EXPERIENCE=5
CURRENT_CTC_LPA=
EXPECTED_CTC_LPA=
DATE_OF_BIRTH=
NOTICE_PERIOD_DAYS=0
NOTICE_PERIOD_TEXT=Immediate
WILLING_TO_RELOCATE=true
WILLING_TO_TRAVEL=true
REQUIRES_SPONSORSHIP=false

# Optional: relative path (from this folder) to a resume PDF. It grounds local
# Ollama job matching and OpenAI answers for unknown screening questions.
# Naukri itself always uses the resume already attached to your profile.
RESUME_PATH=

SEARCH_KEYWORDS=node.js,Backend Developer,Full Stack Developer
SEARCH_EXPERIENCE_YEARS=4
SEARCH_LOCATION=
# Freshness in days (Naukri's jobAge query param). 3 = last 3 days. Leave empty to disable.
SEARCH_JOB_AGE=3

MAX_APPLICATIONS_PER_RUN=15
MAX_APPLICATIONS_PER_KEYWORD=8
MAX_PAGES_PER_KEYWORD=5

# Skip a job (never click Apply) if its computed resume-match score is
# below this percentage. See jobMatch.js.
MIN_MATCH_PERCENT=30
# Blend the local AI model's holistic judgment into the match score
# alongside the deterministic keyword-overlap score. Set to false to use
# keyword-only matching (instant, no Ollama dependency).
MATCH_USE_AI=true

AI_ENABLED=true
AI_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434/api/generate

# OpenAI is used only when qaBank.js cannot answer a screening question.
# Create a new project key and keep it only in .env (never commit or share it).
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-6.1-sol
